# ==============================================================================
# 星云智联（NebulaLink）企业级智能客服与知识库 Agent 系统 - 环境变量配置模板
# 使用说明：复制本文件为 `.env` 并填入真实 API Key（`.env` 已被 .gitignore 忽略）
# 全部模型接口均采用通用 OpenAI 兼容协议，无需修改代码即可切换任意平台。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 对话大模型配置（LLM）
# 默认推荐：Google AI Studio 免费版 OpenAI 兼容接口（海外开发零成本）
# 获取 Key：https://aistudio.google.com/apikey
# ------------------------------------------------------------------------------
LLM_API_KEY=your_gemini_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
# 可选：当主模型遭遇 503 过载或 429 限流重试耗尽时自动降级的备用模型（留空则不启用）
LLM_FALLBACK_MODEL=

# --- 其他 OpenAI 兼容平台切换示例（按需取消注释并替换上面三行）---
# [硅基流动 SiliconFlow（单 Key 同时提供 DeepSeek-V3 对话与免费 BAAI/bge-m3 向量，海内外均可直连）]
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=deepseek-ai/DeepSeek-V3
# LLM_FALLBACK_MODEL=Qwen/Qwen3-8B
#
# [OpenAI 官方]
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
#
# [OpenRouter]
# LLM_API_KEY=sk-or-v1-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=google/gemini-2.5-flash
#
# [DeepSeek（官方 OpenAI 兼容接口，海外/国内均可用）]
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# LLM_FALLBACK_MODEL=deepseek-chat
#
# [阿里云百炼 DashScope 兼容模式]
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
#
# [本地 Ollama]
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# ------------------------------------------------------------------------------
# 2. 向量模型配置（Embedding）
# 默认复用 Google AI Studio 免费版 OpenAI 兼容接口
# ------------------------------------------------------------------------------
EMBEDDING_API_KEY=your_gemini_api_key_here
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_MODEL=gemini-embedding-001

# --- 其他 Embedding 平台切换示例 ---
# [硅基流动 SiliconFlow（免费 BAAI/bge-m3，1024 维，中英检索效果优秀）]
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3
#
# [OpenAI 官方]
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
#
# [阿里云百炼 DashScope]
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v3
#
# [本地 Ollama]
# EMBEDDING_API_KEY=ollama
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_MODEL=bge-m3

# ------------------------------------------------------------------------------
# 3. 重排模型配置（Rerank，可选开关）
# 默认关闭（false）：使用本地免费的 RRF（Reciprocal Rank Fusion）融合算法
# 对向量检索 + BM25 关键词检索结果做精排，零外部依赖与成本。
# 如需启用外部 Rerank API（如 Jina / Cohere / SiliconFlow 等），设为 true 并填写配置。
# ------------------------------------------------------------------------------
RERANK_ENABLED=false
RERANK_API_KEY=
RERANK_BASE_URL=
RERANK_MODEL=

# ------------------------------------------------------------------------------
# 4. 本地存储路径配置
# ------------------------------------------------------------------------------
CHROMA_PERSIST_DIR=data/chroma_db
SQLITE_DB_PATH=data/business.db
